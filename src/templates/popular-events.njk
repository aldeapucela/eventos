{% extends "layout.njk" %}

{% block header %}
{% include "partials/topbar.njk" %}
{% endblock %}

{% block body %}
<main class="page-shell popular-page py-5 sm:py-8 lg:py-10">
  <section aria-labelledby="popular-title">
    <header class="popular-page-heading">
      <div>
        <p class="popular-page-kicker">AGENDA DE VALLADOLID</p>
        <h1 id="popular-title">Eventos populares</h1>
        <p>Los planes que más está guardando y visitando la comunidad.</p>
      </div>
    </header>

    <div class="popular-toolbar">
      <div class="popular-ranking-switch" role="group" aria-label="Ordenar eventos populares">
        <button type="button" data-popular-mode="saves" aria-pressed="true"><i class="fa-solid fa-bookmark" aria-hidden="true"></i><span>Por guardados</span></button>
        <button type="button" data-popular-mode="visits" aria-pressed="false"><i class="fa-solid fa-eye" aria-hidden="true"></i><span>Por visitas</span></button>
      </div>
    </div>

    <p class="popular-results-meta" data-popular-summary aria-live="polite"></p>
    <ol class="event-row-list popular-event-list" data-popular-list aria-label="Eventos populares"></ol>
    <p class="popular-state" data-popular-state role="status" aria-live="polite">Cargando eventos…</p>
  </section>
</main>
{% endblock %}
