{% extends "layout.njk" %}
{% set activeNav = 'saved' %}

{% block header %}
{% include "partials/topbar.njk" %}
{% endblock %}

{% block body %}
<main class="page-shell py-5 sm:py-8 lg:py-10">
  <section class="home-layout space-y-7 lg:space-y-9">
    <div class="section-mobile-head">
      <h1 class="section-mobile-title">Mis guardados</h1>
    </div>

    <div class="saved-empty hidden" data-saved-empty>
      <div class="saved-empty-icon" aria-hidden="true">
        <i class="fa-regular fa-bookmark"></i>
      </div>
      <p class="saved-empty-copy">No tienes nada guardado</p>
      <p class="saved-empty-subcopy">Tus eventos guardados aparecerán aquí.</p>
      <a class="btn-primary" href="/">
        <i class="fa-solid fa-calendar-day"></i>
        <span>Ver eventos</span>
      </a>
    </div>

    <div class="saved-day-groups" data-saved-groups></div>
  </section>
</main>

<button class="scroll-top-btn" type="button" data-scroll-top aria-label="Volver arriba">
  <i class="fa-solid fa-arrow-up"></i>
</button>


{% endblock %}
