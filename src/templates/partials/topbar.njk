<header class="topbar">
  <div class="topbar-inner">
    <a class="header-brand home-brand-mobile flex items-center gap-4" href="/" aria-label="Aldea Pucela Eventos">
      <img src="https://aldeapucela.org/img/logo-web.jpg" alt="" class="home-brand-mobile-mark" />
      <span class="home-brand-mobile-copy">
        <span class="home-brand-mobile-kicker">ALDEA PUCELA</span>
        <span class="home-brand-mobile-title">Eventos</span>
      </span>
    </a>
    {% include "partials/main-nav.njk" %}
    <div class="topbar-actions">
      <button class="header-search-btn inline-flex h-11 w-11 items-center justify-center rounded-full text-slate-500" type="button" data-search-open aria-label="Buscar">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      </button>
      {% include "partials/header-more.njk" %}
      <button class="header-search-btn inline-flex h-11 w-11 items-center justify-center rounded-full text-slate-500 xl:hidden" type="button" data-menu-open aria-label="Abrir menú">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>
