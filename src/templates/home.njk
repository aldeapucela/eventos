{% extends "layout.njk" %}

{% block header %}
{% include "partials/topbar.njk" %}
{% endblock %}

{% block body %}
<main class="page-shell py-5 sm:py-8 lg:py-10">
  <section class="home-layout space-y-8 lg:space-y-10">
    <div class="home-column space-y-6">
      <section class="hero-mobile-copy">
        <div class="hero-mobile-visual">
          <img
            class="hero-mobile-image"
            src="/assets/home-hero.jpg"
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-mobile-overlay">
            <div class="hero-mobile-text-panel">
              <h1 class="hero-mobile-title">Qué hacer en Valladolid</h1>
              <h2 class="hero-mobile-subtitle">Agenda vecinal de eventos culturales</h2>
              <span class="hero-mobile-accent" aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div class="hero-mobile-search hidden" aria-hidden="true">
          <i class="fa-solid fa-magnifying-glass"></i>
          <span>Buscar eventos, lugares, temas...</span>
        </div>

        {% include "partials/quick-filters.njk" %}
      </section>

      {% if featured %}
      {% if featured %}
      <section class="space-y-4">
        <div class="section-mobile-head">
          <h3 class="section-mobile-title">Destacado</h3>
        </div>
        <article class="featured-mobile-card">
          <div class="featured-mobile-image" style="background-image:url('{{ featured.image }}')"></div>
          <div class="featured-mobile-copy">
            <p class="muted-label">{{ featured.categoryLabel or 'Destacado' }}</p>
            <h4 class="featured-mobile-title">{{ featured.title }}</h4>
            <p class="featured-mobile-summary">{{ featured.summary or featured.excerpt }}</p>
            <div class="featured-mobile-meta">
              <span>{% if featured.scheduleLabel %}{{ featured.scheduleLabel }}{% else %}{{ featured.dateRangeLabel }}{% endif %}</span>
            {% if featured.listLocation or featured.location or featured.address %}<span>{{ featured.listLocation or featured.location or featured.address }}</span>{% endif %}
            </div>
            {% if featured.isFree %}
            <span class="compact-badge compact-badge-success">Entrada libre</span>
            {% endif %}
          </div>
        </article>
      </section>
      {% endif %}
      {% endif %}

      {% if ongoing.length %}
      <section class="space-y-3" data-ongoing-section>
        <div class="section-mobile-head">
          <h3 class="section-mobile-title">Eventos en curso</h3>
          <div class="flex gap-2">
            <button class="carousel-nav-btn" data-carousel-prev="ongoing" aria-label="Anterior">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button class="carousel-nav-btn" data-carousel-next="ongoing" aria-label="Siguiente">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </div>
        <div id="ongoing-carousel" class="flex items-stretch overflow-x-auto gap-4 snap-x pb-4 -mx-4 px-4 sm:mx-0 sm:px-0" style="scrollbar-width: none;">
          {% for event in ongoing %}
          <article class="event-compact event-compact-featured event-compact-ongoing flex-none w-[43%] md:w-[23%] snap-start" data-category="{{ event.categoryLabel }}" data-free="{{ 'true' if event.isFree else 'false' }}" data-venue="{{ event.venueLabel or event.venue or event.location or '' }}" data-venue-key="{{ event.venueKey or '' }}" data-starts-at="{{ event.startsAt }}" data-ends-at="{{ event.endsAt }}">
            <div class="event-compact-link">
              <img class="event-compact-image" src="/assets/placeholder-event.svg"{% if event.image %} data-src="{{ event.image }}"{% endif %} alt="" width="400" height="500" loading="lazy" decoding="async" />
              <div class="event-compact-copy">
                <p class="event-compact-topline"><span>{% if event.endsAtDayLabel %}Hasta {{ event.endsAtDayLabel }}{% else %}{% if event.scheduleLabel %}{{ event.scheduleLabel }}{% else %}{{ event.compactDateLabel }}{% if event.timeLabel %} · {{ event.timeLabel }}{% endif %}{% endif %}{% endif %}</span></p>
                <h4 class="event-compact-title"><a href="{{ event.urlPath }}">{{ event.title }}</a></h4>
                <p class="event-compact-meta">{{ event.listLocation or event.location or event.address }}</p>
                <div class="event-compact-badges">
                  <span class="compact-badge">{{ event.categoryLabel or 'Evento' }}</span>
                  {% if event.isFree %}<span class="compact-badge compact-badge-success">Gratis</span>{% endif %}
                </div>
              </div>
            </div>
            <div class="event-compact-actions">
              <button class="event-compact-action" type="button" data-save-event data-event-id="{{ event.id }}" aria-label="Guardar evento" aria-pressed="false">
                <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
              </button>
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <section class="calendar-cta-strip" aria-label="Acciones de calendario">
        <button class="calendar-cta-chip calendar-cta-chip-primary" type="button" data-subscribe-open>
          <i class="fa-regular fa-calendar-plus" aria-hidden="true"></i>
          <span>Calendario</span>
        </button>
        <button class="calendar-cta-chip hidden" type="button" data-install-app-open>
          <i class="fa-solid fa-mobile-screen-button" aria-hidden="true"></i>
          <span data-install-app-label>Añadir al inicio</span>
        </button>
      </section>

      <section class="space-y-3" id="results">
        <div class="section-mobile-head">
          <h3 class="section-mobile-title" data-results-title>Próximos eventos</h3>
          <a class="section-mobile-link hidden" href="/" data-clear-filters>Quitar filtros</a>
        </div>
        {# Renderizado en el build (ver build.mjs, HOME_HORIZON_DAYS). Sin
           data-server-rendered a propósito: home.js lo repinta con el mismo
           markup y sigue gestionando "Ver más" y los filtros. #}
        <div class="week-groups" id="week-groups" data-week-groups data-horizon-days="{{ horizonDays }}">
          {% for group in dayGroups %}
          <section class="week-day-group" data-week-day-group data-day-key="{{ group.key }}">
            <div class="week-day-header">
              <div class="week-day-label">{{ group.label }}</div>
              <div class="day-weather" data-day-weather data-weather-date="{{ group.key }}" hidden aria-label="Previsión del día">
                <i class="fa-solid" data-weather-icon aria-hidden="true"></i>
                <span data-weather-temperature></span>
              </div>
            </div>
            <div class="event-row-list">
              {%- for event in group.events %}
              {% include "partials/event-compact.njk" %}
              {%- endfor %}
            </div>
          </section>
          {% endfor %}
        </div>
        <p class="hidden text-sm leading-6 text-slate-500" data-week-empty>No hay eventos para este filtro.</p>
        <div class="load-more-events" data-load-more-wrap hidden>
          <button class="btn-ghost load-more-events-btn" type="button" data-load-more-events>
            <span>Ver más</span>
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </button>
        </div>

      </section>
    </div>
  </section>
</main>


<button class="scroll-top-btn is-hidden" type="button" data-scroll-top aria-label="Volver arriba">
  <i class="fa-solid fa-arrow-up"></i>
</button>

<button class="share-site-btn" type="button" data-share-site aria-label="Compartir Aldea Pucela Eventos">
  <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
</button>

<button class="add-event-fab" type="button" data-add-event-open aria-label="Añadir evento">
  <i class="fa-solid fa-plus" aria-hidden="true"></i>
</button>

<div class="add-event-modal" data-add-event-modal hidden>
  <button class="add-event-modal-backdrop" type="button" data-add-event-close aria-label="Cerrar diálogo"></button>
  <aside class="add-event-modal-panel" role="dialog" aria-modal="true" aria-labelledby="add-event-title">
    <div class="add-event-modal-head">
      <span class="add-event-modal-mark" aria-hidden="true">
        <i class="fa-solid fa-calendar-plus"></i>
      </span>
      <p class="add-event-modal-title" id="add-event-title">Añade un evento</p>
    </div>
    <p class="add-event-modal-copy">Para publicarlo:</p>
    <ol class="add-event-steps">
      <li><span class="add-event-step-number">1</span><span>Entra al chat de eventos.</span></li>
      <li><span class="add-event-step-number">2</span><span>Interactúa para poder enviar imágenes.</span></li>
      <li><span class="add-event-step-number">3</span><span>Envía el cartel en el subtema de eventos.</span></li>
      <li><span class="add-event-step-number">4</span><span>Lo revisaremos antes de publicarlo.</span></li>
    </ol>
    <a class="add-event-modal-cta" href="https://t.me/AldeaPucela/244/10712" target="_blank" rel="noopener noreferrer">
      Entendido, ir al grupo de chat
    </a>
  </aside>
</div>


{% include "partials/filter-modals.njk" %}
{% endblock %}
