{% extends "layout.njk" %}

{% block bodyClass %}page-event-detail{% endblock %}
{% block footerClass %} site-footer--event-detail{% endblock %}

{% block header %}
<header class="topbar detail-topbar">
  <div class="topbar-inner detail-topbar-inner">
    <div class="flex items-center gap-3 md:hidden">
      <a class="detail-topbar-mobile-back inline-flex items-center justify-center text-slate-500" href="/" aria-label="Volver">
        <i class="fa-solid fa-arrow-left"></i>
      </a>
      <a class="detail-brand-mobile detail-topbar-mobile-brand" href="/" aria-label="Aldea Pucela Eventos">
        <img src="https://aldeapucela.org/img/logo-web.jpg" alt="" class="detail-brand-mobile-mark" />
        <span class="detail-brand-mobile-copy">
          <span class="detail-brand-mobile-kicker">ALDEA PUCELA</span>
          <span class="detail-brand-mobile-title">Eventos</span>
        </span>
      </a>
    </div>
    <a class="header-brand home-brand-mobile hidden items-center gap-4 md:flex" href="/" aria-label="Aldea Pucela Eventos">
      <img src="https://aldeapucela.org/img/logo-web.jpg" alt="" class="home-brand-mobile-mark" />
      <span class="home-brand-mobile-copy">
        <span class="home-brand-mobile-kicker">ALDEA PUCELA</span>
        <span class="home-brand-mobile-title">Eventos</span>
      </span>
    </a>
    {% include "partials/main-nav.njk" %}
    <div class="detail-topbar-actions flex items-center gap-2 text-slate-500 ml-auto">
      <button class="detail-topbar-mobile-action inline-flex items-center justify-center md:hidden" type="button" data-save-event data-event-id="{{ event.id }}" aria-label="Guardar"><i class="fa-regular fa-bookmark"></i></button>
      <button class="hidden md:inline-flex h-11 w-11 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-brand-700" type="button" data-save-event data-event-id="{{ event.id }}" aria-label="Guardar"><i class="fa-regular fa-bookmark"></i></button>
      <button class="hidden md:inline-flex h-11 w-11 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-brand-700" type="button" data-share-event data-event-id="{{ event.id }}" data-event-url="{{ event.urlPath }}" data-event-title="{{ event.title }}" aria-label="Compartir"><i class="fa-solid fa-share-nodes"></i></button>
      <button class="hidden xl:inline-flex h-11 w-11 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-brand-700" type="button" data-search-open aria-label="Buscar"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
      {% include "partials/header-more.njk" %}
      <button class="header-search-btn inline-flex h-11 w-11 items-center justify-center rounded-full text-slate-500 xl:hidden" type="button" data-menu-open aria-label="Abrir menú"><i class="fa-solid fa-bars"></i></button>
    </div>
  </div>
</header>
{% endblock %}

{% block body %}
<main class="page-shell detail-page-main py-0 sm:py-4 lg:py-8">
  <article class="detail-clean">
    <button
      class="detail-clean-hero detail-clean-hero-button"
      type="button"
      data-lightbox-open
      aria-label="Ver imagen completa"
      style="background-image:url('{{ event.image or '/assets/placeholder-event.svg' }}')"
    ></button>
    <div class="detail-clean-body">
      <h1 class="detail-clean-title">{{ event.title }}</h1>
      {% if event.categoryLabel %}
      <a class="compact-badge detail-category-badge" href="{% if categoryPagePaths and categoryPagePaths[event.categoryLabel] %}{{ categoryPagePaths[event.categoryLabel] }}{% else %}/?type={{ event.categoryLabel | urlencode }}#results{% endif %}" aria-label="Ver todos los eventos de {{ event.categoryLabel }}">{{ event.categoryLabel }}</a>
      {% endif %}

      <section class="detail-clean-facts" aria-label="Información del evento">
        {% if event.detailScheduleLabel %}<div class="detail-clean-meta-row"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span>{{ event.detailScheduleLabel }}</span></div>{% elif event.detailDateRangeLabel %}<div class="detail-clean-meta-row"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span>{{ event.detailDateRangeLabel }}</span></div>{% endif %}
        {% if event.displayLocation or event.location or event.address %}<a class="detail-clean-meta-row detail-clean-meta-row-location detail-clean-meta-row-button" data-location-open data-location="{{ event.displayLocation or event.location or event.address }}" {% if event.venueLat != null and event.venueLon != null %}data-location-lat="{{ event.venueLat }}" data-location-lon="{{ event.venueLon }}"{% endif %} href="#"><i class="fa-solid fa-location-dot detail-clean-meta-row-icon" aria-hidden="true"></i><span>{{ event.displayLocation or event.location or event.address }}</span></a>{% endif %}
        <div class="detail-clean-meta-row detail-clean-weather" data-detail-weather data-weather-date="{{ event.startsAtDayKey }}" data-weather-time="{{ event.timeLabel }}" hidden aria-live="polite">
          <i class="fa-solid" data-detail-weather-icon aria-hidden="true"></i>
          <span class="detail-clean-weather-copy"><span class="detail-clean-weather-label">Previsión</span><span data-detail-weather-copy></span></span>
        </div>
        {% if event.ticketUrl %}
        <div class="detail-clean-meta-row detail-ticket-offer-row">
          <i class="fa-solid fa-ticket" aria-hidden="true"></i>
          {% if event.price %}<span class="detail-ticket-price">{{ event.price }}</span>{% else %}<span class="detail-ticket-price">Entradas</span>{% endif %}
          <a class="detail-ticket-search-button" href="{{ event.ticketUrl }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'Inscribirse' if event.isFree else 'Comprar entradas' }}">
            <span>{{ 'Inscribirse' if event.isFree else 'Comprar entradas' }}</span>
          </a>
        </div>
        {% elif not event.isFree and event.price %}
        <div class="detail-clean-meta-row detail-ticket-offer-row">
          <i class="fa-solid fa-ticket" aria-hidden="true"></i>
          <span class="detail-ticket-price">{{ event.price }}</span>
          <button class="detail-ticket-search-button" type="button" data-ticket-search-open aria-label="Buscar entradas">
            <span>Buscar entradas</span>
          </button>
        </div>
        {% elif not event.isFree %}
        <button class="detail-clean-meta-row detail-ticket-search-row" type="button" data-ticket-search-open aria-label="Buscar entradas">
          <i class="fa-solid fa-ticket" aria-hidden="true"></i><span>Buscar entradas</span>
        </button>
        {% elif event.price %}
        <div class="detail-clean-meta-row"><i class="fa-solid fa-ticket" aria-hidden="true"></i><span>{{ event.price }}</span></div>
        {% endif %}
      </section>

      <section class="detail-content-block" aria-labelledby="detail-description-title">
        <h2 id="detail-description-title"><i class="fa-solid fa-person-running" aria-hidden="true"></i>Descripción</h2>
        {% if event.descriptionHtml %}
        <div class="detail-clean-summary detail-clean-description">{{ event.descriptionHtml | safe }}</div>
        {% else %}
        <p class="detail-clean-summary">{{ event.summary or event.excerpt }}</p>
        {% endif %}
        {% if event.organizer or event.notes %}
        <dl class="detail-content-extra">
          {% if event.organizer %}<div><dt>Organiza</dt><dd>{{ event.organizer }}</dd></div>{% endif %}
          {% if event.notes %}<div><dt>Más información</dt><dd>{{ event.notes }}</dd></div>{% endif %}
        </dl>
        {% endif %}
        {% if event.importedFromChatUrl %}
        <p class="detail-import-note">Evento importado del <a href="{{ event.importedFromChatUrl }}" target="_blank" rel="noopener noreferrer">chat de Aldea Pucela</a>.</p>
        {% endif %}
      </section>

      <section class="detail-action-card" aria-label="Acciones del evento">
        <button class="detail-clean-action detail-action-button" type="button" data-save-event data-event-id="{{ event.id }}" aria-label="Guardar evento" aria-pressed="false">
          <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
          <span data-save-label>Guardar</span>
          <span class="detail-action-count" data-event-save-count data-event-id="{{ event.id }}" hidden><span data-count-value>0</span> <span data-count-label>guardados</span></span>
        </button>
        <button class="detail-clean-action detail-action-button" type="button" data-share data-event-id="{{ event.id }}" data-event-title="{{ event.title }}" aria-label="Compartir evento">
          <i class="fa-solid fa-share-nodes" aria-hidden="true"></i><span>Compartir</span>
        </button>
        <button class="detail-clean-action detail-action-button" type="button" data-calendar-open aria-label="Añadir evento al calendario">
          <i class="fa-regular fa-calendar-plus" aria-hidden="true"></i><span>Añadir al calendario</span>
        </button>
      </section>

      <div class="detail-clean-actions detail-clean-actions-sticky md:hidden" role="group" aria-label="Acciones rápidas">
        <button class="detail-clean-action detail-clean-action-primary" type="button" data-calendar-open aria-label="Añadir al calendario">
          <i class="fa-regular fa-calendar-plus" aria-hidden="true"></i><span>Calendario</span>
        </button>
        <button class="detail-clean-action detail-clean-action-icon-only" type="button" data-comments-open aria-label="Ver comentarios">
          <i class="fa-regular fa-comment" aria-hidden="true"></i>
          <span class="js-comment-count-number hidden font-semibold text-sm"></span>
          <span class="js-comment-label">Comentarios</span>
        </button>
        <button class="detail-clean-action detail-clean-action-icon-only" type="button" data-share-event data-event-id="{{ event.id }}" data-event-url="{{ event.urlPath }}" data-event-title="{{ event.title }}" aria-label="Compartir">
          <i class="fa-solid fa-share-nodes" aria-hidden="true"></i><span>Compartir</span>
        </button>
      </div>

      {% if event.displayLocation or event.location or event.address or (event.venueLat != null and event.venueLon != null) %}
      <section class="detail-map-card" aria-label="Mapa y cómo llegar">
        {% if event.venueLat != null and event.venueLon != null %}
        <div class="detail-map" data-event-map data-lat="{{ event.venueLat }}" data-lon="{{ event.venueLon }}" data-title="{{ event.displayLocation or event.location or event.title }}" role="application" aria-label="Mapa de {{ event.displayLocation or event.location or event.title }}"></div>
        <div class="detail-map-error" data-event-map-error hidden role="status"></div>
        {% else %}
        <div class="detail-map-empty">
          <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
          <p>Ubicación en el mapa no disponible.</p>
          <span>{{ event.displayLocation or event.location or event.address or 'Lugar por confirmar' }}</span>
        </div>
        {% endif %}
        <div class="detail-map-actions">
          <a class="detail-map-action" data-location-open data-location="{{ event.displayLocation or event.address or event.location or event.title }}" {% if event.venueLat != null and event.venueLon != null %}data-location-lat="{{ event.venueLat }}" data-location-lon="{{ event.venueLon }}"{% endif %} href="#">
            <i class="fa-regular fa-map" aria-hidden="true"></i><span>Ver en mapa</span>
          </a>
          {% if event.venueLat != null and event.venueLon != null %}
          <button class="detail-map-action" type="button" data-directions-toggle aria-controls="event-directions-options-{{ event.id }}" aria-expanded="false">
            <i class="fa-solid fa-route" aria-hidden="true"></i><span>Cómo llegar</span>
          </button>
          {% else %}
          <a class="detail-map-action" href="https://www.google.com/maps/dir/?api=1&amp;destination={{ (event.displayLocation or event.address or event.location or event.title) | urlencode }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-route" aria-hidden="true"></i><span>Cómo llegar</span>
          </a>
          {% endif %}
        </div>
        {% if event.venueLat != null and event.venueLon != null %}
        <section class="detail-directions-options" id="event-directions-options-{{ event.id }}" data-directions-options hidden aria-label="Opciones para llegar">
          <div class="detail-directions-grid">
            <a class="detail-directions-option" href="https://vallabus.com/#/rutas?origen=eventosaldea" target="_blank" rel="noopener noreferrer" data-vallabus-route data-destination-name="{{ event.displayLocation or event.location or event.title }}" data-destination-lat="{{ event.venueLat }}" data-destination-lon="{{ event.venueLon }}" data-arrival-date="{{ event.startsAtDayKey }}" data-arrival-time="{{ event.timeLabel }}">
              <i class="fa-solid fa-bus" aria-hidden="true"></i><span>Bus</span>
            </a>
            <a class="detail-directions-option" href="https://vallabus.com/#/rutas?origen=eventosaldea" target="_blank" rel="noopener noreferrer" data-vallabus-route data-route-mode="bike" data-destination-name="{{ event.displayLocation or event.location or event.title }}" data-destination-lat="{{ event.venueLat }}" data-destination-lon="{{ event.venueLon }}" data-arrival-date="{{ event.startsAtDayKey }}" data-arrival-time="{{ event.timeLabel }}">
              <i class="fa-solid fa-bicycle" aria-hidden="true"></i><span>Bici/BIKI</span>
            </a>
            <a class="detail-directions-option" href="https://www.google.com/maps/dir/?api=1&amp;destination={{ event.venueLat }},{{ event.venueLon }}" target="_blank" rel="noopener noreferrer" data-native-map data-lat="{{ event.venueLat }}" data-lon="{{ event.venueLon }}" data-title="{{ event.displayLocation or event.location or event.title }}">
              <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i><span>Tu App</span>
            </a>
          </div>
        </section>
        {% endif %}
        {% if event.nearbyVallabusLines and event.nearbyVallabusLines.length %}
        <section class="detail-transit" data-event-transit aria-label="Líneas de autobús cercanas">
          <div class="detail-transit-row">
            <span class="detail-transit-icon" aria-hidden="true"><i class="fa-solid fa-bus"></i></span>
            <button class="detail-transit-scroll" type="button" data-transit-scroll="prev" aria-label="Ver líneas anteriores" aria-controls="event-transit-lines-{{ event.id }}" hidden><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
            <div class="detail-transit-lines" id="event-transit-lines-{{ event.id }}" data-transit-lines role="group" aria-label="Líneas de autobús cercanas" tabindex="0">
              {% for line in event.nearbyVallabusLines %}<button class="detail-transit-line" type="button" data-transit-line="{{ line }}" aria-controls="event-transit-stops-{{ event.id }}" aria-expanded="false">{{ line }}</button>{% endfor %}
            </div>
            <button class="detail-transit-scroll" type="button" data-transit-scroll="next" aria-label="Ver más líneas" aria-controls="event-transit-lines-{{ event.id }}" hidden><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
          </div>
          <div class="detail-transit-details" id="event-transit-stops-{{ event.id }}" data-transit-details hidden>
            <p class="detail-transit-summary" data-transit-summary></p>
            <ul class="detail-transit-stop-list" data-transit-stop-list></ul>
            <a class="detail-transit-planner" href="https://vallabus.com/#/rutas?origen=eventosaldea" target="_blank" rel="noopener noreferrer" data-vallabus-route data-destination-name="{{ event.displayLocation or event.location or event.title }}" data-destination-lat="{{ event.venueLat }}" data-destination-lon="{{ event.venueLon }}" data-arrival-date="{{ event.startsAtDayKey }}" data-arrival-time="{{ event.timeLabel }}">
              <i class="fa-solid fa-route" aria-hidden="true"></i><span>Planificar ruta en VallaBus</span>
            </a>
          </div>
        </section>
        {% endif %}
      </section>
      {% endif %}

      <aside class="detail-community-card" aria-labelledby="detail-community-title">
        <div class="detail-community-heading">
          <img class="detail-community-logo" src="https://aldeapucela.org/img/logo-web.jpg" alt="" />
          <div><p class="detail-community-kicker">ALDEA PUCELA</p><h2 id="detail-community-title">Los eventos también se viven en comunidad</h2></div>
        </div>
        <p class="detail-community-copy">Recibe lo importante cada semana, comenta los planes con otros vecinos y sigue la actualidad de Valladolid.</p>
        <a class="detail-community-primary" href="https://aldeapucela.org/boletin/?mtm_campaign=webeventos" target="_blank" rel="noopener noreferrer"><i class="fa-regular fa-envelope" aria-hidden="true"></i><span>Recibir el resumen semanal</span></a>
        <div class="detail-community-secondary">
          <a href="https://t.me/aldeapucela/59137" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-telegram" aria-hidden="true"></i><span>Unirme al chat de Aldea Pucela</span></a>
          <a href="https://aldeapucela.org/whatsapp" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>Canal de WhatsApp</span></a>
          <a href="https://www.facebook.com/aldeapucela" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-facebook" aria-hidden="true"></i><span>Página en Facebook</span></a>
          <a href="https://www.instagram.com/aldeapucela" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-instagram" aria-hidden="true"></i><span>Instagram</span></a>
        </div>
      </aside>



      {% if relatedEvents.length %}
      <section class="detail-related mt-12 space-y-4 pt-10 border-t border-line">
        <div class="section-mobile-head">
          <h2 class="section-mobile-title">Eventos relacionados</h2>
        </div>
        <div class="flex overflow-x-auto gap-4 snap-x pb-4 -mx-4 px-4 sm:mx-0 sm:px-0" style="scrollbar-width: none;">
          {% for related in relatedEvents %}
          <article class="event-compact flex-none w-[46%] md:w-[23%] snap-start">
            <div class="event-compact-link">
              <div class="event-compact-image" style="background-image:url('{{ related.image or '/assets/placeholder-event.svg' }}')"></div>
              <div class="event-compact-copy">
                <p class="event-compact-topline"><span>{{ related.scheduleLabel }}</span></p>
                <h4 class="event-compact-title"><a href="{{ related.urlPath }}">{{ related.title }}</a></h4>
                <p class="event-compact-meta">{{ related.displayLocation or related.location }}</p>
                <div class="event-compact-badges">
                  <span class="compact-badge">{{ related.categoryLabel or 'Evento' }}</span>
                  {% if related.isFree %}<span class="compact-badge compact-badge-success">Gratis</span>{% endif %}
                </div>
              </div>
            </div>
            <div class="event-compact-actions">
              <button class="event-compact-action" type="button" data-save-event data-event-id="{{ related.id }}" aria-label="Guardar evento" aria-pressed="false">
                <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
              </button>
            </div>
          </article>
          {% endfor %}
        </div>
        <div class="mt-2">
          <a class="detail-clean-action" href="{% if categoryPagePaths and categoryPagePaths[event.categoryLabel] %}{{ categoryPagePaths[event.categoryLabel] }}{% else %}/?type={{ event.categoryLabel | urlencode }}#results{% endif %}">
            <i class="fa-solid fa-list-ul"></i>
            <span>Ver más en {{ event.categoryLabel }}</span>
          </a>
        </div>
      </section>
      {% endif %}

      {% if moreInVenueEvents.length %}
      <section class="detail-related mt-12 space-y-4 pt-10 border-t border-line">
        <div class="section-mobile-head">
          <h2 class="section-mobile-title">Más en {{ moreInVenueTitle }}</h2>
        </div>
        <div class="flex overflow-x-auto gap-4 snap-x pb-4 -mx-4 px-4 sm:mx-0 sm:px-0" style="scrollbar-width: none;">
          {% for related in moreInVenueEvents %}
          <article class="event-compact flex-none w-[46%] md:w-[23%] snap-start">
            <div class="event-compact-link">
              <div class="event-compact-image" style="background-image:url('{{ related.image or '/assets/placeholder-event.svg' }}')"></div>
              <div class="event-compact-copy">
                <p class="event-compact-topline"><span>{{ related.scheduleLabel }}</span></p>
                <h4 class="event-compact-title"><a href="{{ related.urlPath }}">{{ related.title }}</a></h4>
                <p class="event-compact-meta">{{ related.displayLocation or related.location }}</p>
                <div class="event-compact-badges">
                  <span class="compact-badge">{{ related.categoryLabel or 'Evento' }}</span>
                  {% if related.isFree %}<span class="compact-badge compact-badge-success">Gratis</span>{% endif %}
                </div>
              </div>
            </div>
            <div class="event-compact-actions">
              <button class="event-compact-action" type="button" data-save-event data-event-id="{{ related.id }}" aria-label="Guardar evento" aria-pressed="false">
                <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
              </button>
            </div>
          </article>
          {% endfor %}
        </div>
        <div class="mt-2">
          <a class="detail-clean-action" href="{{ moreInVenueHref }}">
            <i class="fa-solid fa-location-dot"></i>
            <span>Ver más en {{ moreInVenueTitle }}</span>
          </a>
        </div>
      </section>
      {% endif %}

      <section
        id="comentarios"
        class="js-comments-root detail-comments"
        data-discourse-url="https://foro.aldeapucela.org/"
        data-topic-id="{{ event.id }}"
        data-topic-url="{{ event.sourceUrl }}"
        data-topic-json-url="{{ event.sourceUrl }}.json"
        data-initial-replies="0"
        data-comments
      >
        <div class="detail-comments-head">
          <div class="w-full text-left">
            <h2 class="detail-comments-title">Comentarios</h2>
          </div>
          <a
            href="{{ event.sourceUrl }}/2"
            class="js-add-comment-link btn-ghost detail-comments-link hidden"
            target="_blank"
            rel="noreferrer"
            style="white-space: nowrap;"
          >
            Añadir comentario
          </a>
        </div>

        <div class="js-comments-embed-wrapper hidden mt-8 overflow-hidden rounded-2xl bg-white p-4 sm:p-6">
          <div id="discourse-comments" class="js-comments-embed bg-white"></div>
        </div>

        <div class="js-comments-empty-state mt-6 text-left">
          <p class="detail-comments-empty-title text-lg font-semibold">¿Qué piensas de este evento?</p>
          <p class="detail-comments-empty-copy mt-1 text-sm leading-relaxed">
            Sé la primera persona en comentar y comparte tu punto de vista.
          </p>
          <a
            href="{{ event.sourceUrl }}/2"
            class="mt-4 btn-primary"
            target="_blank"
            rel="noreferrer"
          >
            Añadir un comentario
          </a>
        </div>
      </section>

    </div>
  </article>
</main>

{# Los modales (calendario, entradas, lightbox, ubicación, suscripción y el
   drawer) NO van en el HTML: se inyectan al primer clic desde
   src/scripts/modals.js. Eran el 46% de las palabras visibles de esta página,
   idénticas en las ~1.400 fichas. Aquí solo quedan los botones que los abren. #}

<script>
  window.__EVENT_DETAIL__ = {{ eventDetailJson | safe }};
</script>
{% endblock %}
