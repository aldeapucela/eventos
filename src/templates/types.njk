{% extends "layout.njk" %}

{% block header %}
{% include "partials/topbar.njk" %}
{% endblock %}

{% block body %}
<main class="page-shell py-5 sm:py-8 lg:py-10">
  <section class="home-layout space-y-7 lg:space-y-9">
    <section class="spaces-hero-copy">
      <h1 class="spaces-page-title">Tipos de evento</h1>
      <p class="spaces-hero-text">Eventos por categoría</p>
    </section>

    {% if types.length == 0 %}
    <div class="saved-empty">
      <div class="saved-empty-icon" aria-hidden="true">
        <i class="fa-solid fa-filter"></i>
      </div>
      <p class="saved-empty-copy">No hay tipos con eventos vigentes</p>
      <p class="saved-empty-subcopy">Aquí aparecerán los tipos con eventos.</p>
    </div>
    {% else %}
    <div class="spaces-groups">
      {% for type in types %}
      <section class="spaces-card" id="{{ type.slug }}">
        <div class="spaces-card-head">
          <div class="spaces-card-copy">
            <h2 class="spaces-card-title"><a href="{{ type.path }}">{{ type.label }}</a></h2>
            <div class="spaces-card-meta">
              <span><i class="fa-regular fa-calendar" aria-hidden="true"></i>{{ type.count }} {% if type.count == 1 %}evento{% else %}eventos{% endif %}</span>
            </div>
          </div>
        </div>

        <div class="event-row-list">
          {% for event in type.events %}
          {% include "partials/event-compact.njk" %}
          {% endfor %}
        </div>

        <div class="mt-2">
          <a class="detail-clean-action" href="{{ type.path }}">
            <i class="fa-solid fa-list-ul"></i>
            <span>Ver más en {{ type.label }}</span>
          </a>
        </div>
      </section>
      {% endfor %}
    </div>
    {% endif %}
  </section>
</main>

<button class="scroll-top-btn is-hidden" type="button" data-scroll-top aria-label="Volver arriba">
  <i class="fa-solid fa-arrow-up"></i>
</button>


{% endblock %}
